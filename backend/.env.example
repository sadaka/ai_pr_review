# Copy to backend/.env and fill in. docker-compose.yml reads this file.
# REDIS_URL is set by compose (redis://redis:6379); override only for bare-metal runs.

# --- Tiger Cloud / Postgres (external — not run by compose) ---
TIGER_DATABASE_URL=postgres://user:pass@host:5432/dbname?sslmode=require

# --- LLM (OpenAI-compatible; used by the worker for specialists + embeddings) ---
OPENAI_API_KEY=sk-...

# --- GitHub App (webhook receiver + posting reviews) ---
GITHUB_WEBHOOK_SECRET=...
GITHUB_APP_ID=123456
# Path *inside the container*. compose mounts ./backend/secrets -> /run/secrets.
GITHUB_PRIVATE_KEY_PATH=/run/secrets/ai-pr-review.private-key.pem

# --- Local/bare-metal only (compose injects this itself) ---
# REDIS_URL=redis://localhost:6379
